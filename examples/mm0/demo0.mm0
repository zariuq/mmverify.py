delimiter $ ( $ $ ) $;

provable sort wff;

sort term;

--| Define "term" (part 1 of 2).
term tze: term;

--| Define "term" (part 2 of 2).
term tpl (t r: term): term;

--| Define "wff" (part 1 of 2).
term weq (t r: term): wff;

--| Define "wff" (part 2 of 2).
term wim (P Q: wff): wff;

--| State Axiom ~ a1 .
axiom a1 (t r s: term):
  $ wim (weq t r) (wim (weq t s) (weq r s)) $;

--| State Axiom ~ a2 .
axiom a2 (t: term):
  $ weq (tpl t tze) t $;

--| Define the modus ponens inference rule.
axiom mp (P Q: wff):
  $ P $ >
  $ wim P Q $ >
  $ Q $;

--| Prove a theorem. (Contributed by NM, 1-Jan-2004.)
theorem th1 (t: term):
  $ weq t t $;

