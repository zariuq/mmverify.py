!(bind! &sp (new-state -1))
!(bind! &fd (new-state 0))
!(import! &self ../mmverify-utils_petta)
!(push-frame &fd)
!(exec (add_c &kb "0"))
!(exec (add_c &kb "+"))
!(exec (add_c &kb "="))
!(exec (add_c &kb "->"))
!(exec (add_c &kb "("))
!(exec (add_c &kb ")"))
!(exec (add_c &kb "term"))
!(exec (add_c &kb "wff"))
!(exec (add_c &kb "|-"))
!(exec (add_v &kb "t" 1))
!(exec (add_v &kb "r" 1))
!(exec (add_v &kb "s" 1))
!(exec (add_v &kb "P" 1))
!(exec (add_v &kb "Q" 1))
!(exec (add_f &kb "tt" "term" "t" 1))
!(exec (add_f &kb "tr" "term" "r" 1))
!(exec (add_f &kb "ts" "term" "s" 1))
!(exec (add_f &kb "wp" "wff" "P" 1))
!(exec (add_f &kb "wq" "wff" "Q" 1))
!(exec (add_a &kb "tze" ("term" "0")))
!(exec (add_a &kb "tpl" ("term" "(" "t" "+" "r" ")")))
!(exec (add_a &kb "weq" ("wff" "t" "=" "r")))
!(exec (add_a &kb "wim" ("wff" "(" "P" "->" "Q" ")")))
!(exec (add_a &kb "a1" ("|-" "(" "t" "=" "r" "->" "(" "t" "=" "s" "->" "r" "=" "s" ")" ")")))
!(exec (add_a &kb "a2" ("|-" "(" "t" "+" "0" ")" "=" "t")))
!(push-frame &fd)
!(exec (add_e &kb "min" ("|-" "P") 2))
!(exec (add_e &kb "maj" ("|-" "(" "P" "->" "Q" ")") 2))
!(exec (add_a &kb "mp" ("|-" "Q")))
!(pop-frame &kb &fd)
!(exec (add_p &kb &stack &sp "th1" ("|-" "t" "=" "t") ("tt" "tze" "tpl" "tt" "weq" "tt" "tt" "weq" "tt" "a2" "tt" "tze" "tpl" "tt" "weq" "tt" "tze" "tpl" "tt" "weq" "tt" "tt" "weq" "wim" "tt" "a2" "tt" "tze" "tpl" "tt" "tt" "a1" "mp" "mp") True))
!(pop-frame &kb &fd)
