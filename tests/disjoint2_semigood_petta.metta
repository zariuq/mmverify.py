!(bind! &sp (new-state -1))
!(bind! &fd (new-state 0))
!(import! &self ../mmverify-utils_petta)
!(push-frame &fd)
!(exec (add_c &kb "formula"))
!(exec (add_c &kb "|-"))
!(exec (add_c &kb "("))
!(exec (add_c &kb ")"))
!(exec (add_v &kb "x" 1))
!(exec (add_v &kb "y" 1))
!(exec (add_v &kb "z" 1))
!(exec (add_v &kb "w" 1))
!(exec (add_f &kb "xf" "formula" "x" 1))
!(exec (add_f &kb "yf" "formula" "y" 1))
!(exec (add_f &kb "zf" "formula" "z" 1))
!(exec (add_f &kb "wf" "formula" "w" 1))
!(exec (add_a &kb "combo" ("formula" "(" "x" "y" ")")))
!(push-frame &fd)
!(exec (add_d &kb ("x" "y") 2))
!(exec (add_a &kb "ax-1" ("|-" "(" "x" "y" ")")))
!(pop-frame &kb &fd)
!(exec (add_p &kb &stack &sp "semigood" ("|-" "(" "(" "x" "y" ")" "(" "z" "w" ")" ")") ("xf" "yf" "combo" "zf" "wf" "combo" "ax-1") True))
!(pop-frame &kb &fd)
