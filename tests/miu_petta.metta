!(bind! &sp (new-state -1))
!(bind! &fd (new-state 0))
!(import! &self ../mmverify-utils_petta)
!(push-frame &fd)
!(exec (add_c &kb "M"))
!(exec (add_c &kb "I"))
!(exec (add_c &kb "U"))
!(exec (add_c &kb "|-"))
!(exec (add_c &kb "wff"))
!(exec (add_v &kb "x" 1))
!(exec (add_v &kb "y" 1))
!(exec (add_f &kb "wx" "wff" "x" 1))
!(exec (add_f &kb "wy" "wff" "y" 1))
!(exec (add_a &kb "we" ("wff")))
!(exec (add_a &kb "wM" ("wff" "x" "M")))
!(exec (add_a &kb "wI" ("wff" "x" "I")))
!(exec (add_a &kb "wU" ("wff" "x" "U")))
!(exec (add_a &kb "wxy" ("wff" "x" "y")))
!(exec (add_a &kb "ax" ("|-" "M" "I")))
!(push-frame &fd)
!(exec (add_e &kb "Ia" ("|-" "x" "I") 2))
!(exec (add_a &kb "I_" ("|-" "x" "I" "U")))
!(pop-frame &kb &fd)
!(push-frame &fd)
!(exec (add_e &kb "IIa" ("|-" "M" "x") 2))
!(exec (add_a &kb "II" ("|-" "M" "x" "x")))
!(pop-frame &kb &fd)
!(push-frame &fd)
!(exec (add_e &kb "IIIa" ("|-" "x" "I" "I" "I" "y") 2))
!(exec (add_a &kb "III" ("|-" "x" "U" "y")))
!(pop-frame &kb &fd)
!(push-frame &fd)
!(exec (add_e &kb "IVa" ("|-" "x" "U" "U" "y") 2))
!(exec (add_a &kb "IV" ("|-" "x" "y")))
!(pop-frame &kb &fd)
!(exec (add_p &kb &stack &sp "theorem1" ("|-" "M" "U" "I" "I" "U") ("we" "wM" "wU" "wI" "we" "wI" "wU" "we" "wU" "wI" "wU" "we" "wM" "we" "wI" "wU" "we" "wM" "wI" "wI" "wI" "we" "wI" "wI" "we" "wI" "ax" "II" "II" "I_" "III" "II" "IV") True))
!(pop-frame &kb &fd)
