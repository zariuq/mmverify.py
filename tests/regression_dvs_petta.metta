!(bind! &sp (new-state -1))
!(bind! &fd (new-state 0))
!(import! &self ../mmverify-utils_petta)
!(push-frame &fd)
!(exec (add_c &kb "("))
!(exec (add_c &kb ")"))
!(exec (add_c &kb "->"))
!(exec (add_c &kb "wff"))
!(exec (add_c &kb "term"))
!(exec (add_c &kb "|-"))
!(exec (add_c &kb "="))
!(exec (add_v &kb "x" 1))
!(exec (add_v &kb "y" 1))
!(exec (add_v &kb "z" 1))
!(exec (add_f &kb "vx" "term" "x" 1))
!(exec (add_f &kb "vy" "term" "y" 1))
!(exec (add_f &kb "vz" "term" "z" 1))
!(push-frame &fd)
!(exec (add_d &kb ("x" "y") 2))
!(exec (add_a &kb "ax-disjoint" ("|-" "x" "=" "y")))
!(pop-frame &kb &fd)
!(push-frame &fd)
!(exec (add_p &kb &stack &sp "verybad" ("|-" "x" "=" "x") ("vx" "vx" "ax-disjoint") True))
!(pop-frame &kb &fd)
!(pop-frame &kb &fd)
