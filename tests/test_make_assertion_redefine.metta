!(import! &self mmverify-utils_petta_partial)

!(println! "Redefining make_assertion...")

(= (make_assertion $kb $stmt)
  (let*
    (
      ($e_hyps_lists (matchc &self ($kb (EList (FSDepth $level) $elist)) ($level $elist)))
      ($_1 (println! ("e_hyps lists:" $e_hyps_lists)))
      ($e_levels (collapse (match-atom' $e_hyps_lists ($l $_) $l)))
      ($_2 (println! ("e_levels:" $e_levels)))
      ($e_max_level (if (== $e_levels (())) 0 (max-atom $e_levels)))
      ($_3 (println! ("max_level of ehyps frame stack:" $e_max_level)))
      ($e_hyps_list (collect_lists_by_depth $e_hyps_lists 1 $e_max_level Nil))
      ($_4 (println! ("e_hyps_list:" $e_hyps_list)))
      ($e_hyps_toks (from-list (flatten-list $e_hyps_list)))
      ($_5 (map-atom $e_hyps_toks $tok (add_mand_var $kb $tok)))
      ($_6 (map-atom $stmt $tok (add_mand_var $kb $tok)))
      ($mand_vars (matchc &self ($kb (MandVar $var)) $var))
      ($_7 (println! ("mand_vars:" $mand_vars)))
      ($dvs (matchc &self ($kb (DVar ($x $y) $_ (Type "$d")))
              (case (collapse (match &self ($kb (MandVar $x)) found))
                (((found)
                   (case (collapse (match &self ($kb (MandVar $y)) found))
                     (((found) ($x $y)))
                      (() ()))))
                 (() ())))))
      ($_8 (println! ("dvs:" $dvs)))
      ($f_hyps_lists (matchc &self ($kb (FList (FSDepth $level) $flist)) ($level $flist)))
      ($_9 (println! ("f_hyps lists:" $f_hyps_lists)))
      ($f_levels (collapse (match-atom' $f_hyps_lists ($l $_) $l)))
      ($_10 (println! ("f_levels:" $f_levels)))
      ($f_max_level (if (== $f_levels (())) 0 (max-atom $f_levels)))
      ($_11 (println! ("max_level of fhyps frame stack:" $f_max_level)))
      ($f_hyps_list (collect_lists_by_depth $f_hyps_lists 1 $f_max_level Nil))
      ($_12 (println! ("f_hyps_list:" $f_hyps_list)))
      ($f_hyps (assign_f_hyps $kb $f_hyps_list))
      ($_13 (println! ("f_hyps:" $f_hyps)))
      ($mand_vars' (matchc &self ($kb (MandVar $var)) $var))
      ($_14 (println! ("mand_vars':" $mand_vars')))
      ($_15 (remove-patternc &self ($kb (MandVar $var))))
) ( (DVars $dvs) (FHyps (from-list $f_hyps)) (EHyps (from-list $e_hyps_list)) (Statement $stmt) ))

!(println! "Testing...")
!(add-atom &self (testspace (EList (FSDepth 1) Nil)))
!(add-atom &self (testspace (FList (FSDepth 1) Nil)))
!(make_assertion testspace (wff p))
!(println! "Done!")

