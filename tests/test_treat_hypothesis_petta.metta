; PeTTa version of treat_hypothesis test suite (new-space style)
!(import! &self ../mmverify-utils_petta)

!(println! "=== treat_hypothesis Tests (PeTTa) ===")
!(println! "")

!(println! "Test 1: Process FHyp (floating hypothesis)")
!(bind! &thkb1 (new-space))
!(bind! &thst1 (new-space))
!(add-atom &thkb1 (ActiveHyp "tt"))
!(treat_hypothesis &thkb1 &thst1 "tt" FHyp ((Typecode "term") (FVar "t") (Type "$f")) 0)
!(test (collapse (match &thst1 ((Num 0) $entry) $entry)) (("term" "t")))

!(println! "Test 2: Process EHyp (essential hypothesis)")
!(bind! &thkb2 (new-space))
!(bind! &thst2 (new-space))
!(add-atom &thkb2 (ActiveHyp "min"))
!(treat_hypothesis &thkb2 &thst2 "min" EHyp ((Statement ("|-" "P")) (Type "$e")) 0)
!(test (collapse (match &thst2 ((Num 0) $entry) $entry)) (("|-" "P")))

!(println! "Test 3: Multiple FHyps at different stack positions")
!(bind! &thkb3 (new-space))
!(bind! &thst3 (new-space))
!(add-atom &thkb3 (ActiveHyp "tt"))
!(add-atom &thkb3 (ActiveHyp "tr"))
!(treat_hypothesis &thkb3 &thst3 "tt" FHyp ((Typecode "term") (FVar "t") (Type "$f")) 0)
!(treat_hypothesis &thkb3 &thst3 "tr" FHyp ((Typecode "term") (FVar "r") (Type "$f")) 1)
!(test (collapse (match &thst3 ((Num 0) $entry) $entry)) (("term" "t")))
!(test (collapse (match &thst3 ((Num 1) $entry) $entry)) (("term" "r")))

!(println! "Test 4: Error - hypothesis not active")
!(bind! &thkb4 (new-space))
!(bind! &thst4 (new-space))
!(test (treat_hypothesis &thkb4 &thst4 "bad" FHyp ((Typecode "wff") (FVar "P") (Type "$f")) 0)
       (Error (label "bad") "The label is the label of a nonactive hypothesis."))

!(println! "Test 5: FHyp with wff typecode")
!(bind! &thkb5 (new-space))
!(bind! &thst5 (new-space))
!(add-atom &thkb5 (ActiveHyp "wp"))
!(treat_hypothesis &thkb5 &thst5 "wp" FHyp ((Typecode "wff") (FVar "P") (Type "$f")) 0)
!(test (collapse (match &thst5 ((Num 0) $entry) $entry)) (("wff" "P")))

!(println! "Test 6: EHyp with complex statement")
!(bind! &thkb6 (new-space))
!(bind! &thst6 (new-space))
!(add-atom &thkb6 (ActiveHyp "eq"))
!(treat_hypothesis &thkb6 &thst6 "eq" EHyp ((Statement ("|-" "(" "t" "+" "0" ")" "=" "t")) (Type "$e")) 0)
!(test (collapse (match &thst6 ((Num 0) $entry) $entry)) (("|-" "(" "t" "+" "0" ")" "=" "t")))

!(println! "Test 7: Stack positions accumulate correctly")
!(bind! &thkb7 (new-space))
!(bind! &thst7 (new-space))
!(add-atom &thkb7 (ActiveHyp "h1"))
!(add-atom &thkb7 (ActiveHyp "h2"))
!(add-atom &thkb7 (ActiveHyp "h3"))
!(treat_hypothesis &thkb7 &thst7 "h1" FHyp ((Typecode "term") (FVar "x") (Type "$f")) 0)
!(treat_hypothesis &thkb7 &thst7 "h2" EHyp ((Statement ("|-" "P")) (Type "$e")) 1)
!(treat_hypothesis &thkb7 &thst7 "h3" FHyp ((Typecode "wff") (FVar "Q") (Type "$f")) 2)
!(test (collapse (match &thst7 ((Num $n) $entry) $n)) (0 1 2))

!(println! "Test 8: Realistic scenario - multiple hypotheses for a theorem")
!(bind! &thkb8 (new-space))
!(bind! &thst8 (new-space))
!(add-atom &thkb8 (ActiveHyp "tt"))
!(add-atom &thkb8 (ActiveHyp "tr"))
!(add-atom &thkb8 (ActiveHyp "min"))
!(treat_hypothesis &thkb8 &thst8 "tt" FHyp ((Typecode "term") (FVar "t") (Type "$f")) 0)
!(treat_hypothesis &thkb8 &thst8 "tr" FHyp ((Typecode "term") (FVar "r") (Type "$f")) 1)
!(treat_hypothesis &thkb8 &thst8 "min" EHyp ((Statement ("|-" "t" "=" "r")) (Type "$e")) 2)
!(test (collapse (match &thst8 ((Num $n) $entry) ($n $entry)))
       ((0 ("term" "t")) (1 ("term" "r")) (2 ("|-" "t" "=" "r"))))

!(println! "Test 9: Empty statement in EHyp")
!(bind! &thkb9 (new-space))
!(bind! &thst9 (new-space))
!(add-atom &thkb9 (ActiveHyp "empty"))
!(treat_hypothesis &thkb9 &thst9 "empty" EHyp ((Statement ()) (Type "$e")) 0)
!(test (collapse (match &thst9 ((Num 0) $entry) $entry)) (()))

!(println! "Test 10: Different typecodes")
!(bind! &thkb10 (new-space))
!(bind! &thst10 (new-space))
!(add-atom &thkb10 (ActiveHyp "class"))
!(add-atom &thkb10 (ActiveHyp "setvar"))
!(treat_hypothesis &thkb10 &thst10 "class" FHyp ((Typecode "class") (FVar "A") (Type "$f")) 0)
!(treat_hypothesis &thkb10 &thst10 "setvar" FHyp ((Typecode "setvar") (FVar "x") (Type "$f")) 1)
!(test (collapse (match &thst10 ((Num 0) $entry) $entry)) (("class" "A")))
!(test (collapse (match &thst10 ((Num 1) $entry) $entry)) (("setvar" "x")))

!(println! "")
!(println! "=== All treat_hypothesis tests complete ===")
